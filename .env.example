# Copy to .env.local for development. Never commit real values. Setup guide: docs/supabase-setup.md
# In production (Vercel) set them as encrypted Environment Variables, one value per environment
# (Preview and Production never share secrets). A production server refuses to start when a
# variable marked REQUIRED is missing (src/lib/config/env.ts). Rotation: docs/launch-checklist.md.
# NODE_ENV, NEXT_RUNTIME and NEXT_PHASE are set by Node/Next.js, not here.

# REQUIRED in production.
# Postgres (Supabase session pooler, port 5432). Unset in development: a local PGlite database is used.
DATABASE_URL=
# Optional: connection used only by `npm run db:migrate` (direct or session pooler, never the transaction pooler).
DATABASE_URL_MIGRATE=
# PEM text of the database CA certificate (Supabase: Database settings → SSL). One line with \n escapes is fine.
DATABASE_CA_CERT=
# Development only: 1 = encrypted connection WITHOUT certificate verification when there is no CA. Ignored in production.
DATABASE_SSL_INSECURE=
# Optional: max connections per server instance (default 5).
DATABASE_POOL_MAX=
# Optional: server-side statement timeout in ms (default 30000; 0 = do not send it, for poolers that reject it).
DATABASE_STATEMENT_TIMEOUT_MS=

# REQUIRED in production.
# Secret used to sign short-lived private-file URLs (>= 32 random characters).
FILE_URL_SECRET=

# REQUIRED in production.
# Vercel Blob read/write token (private store). Unset in development: files are kept in memory.
BLOB_READ_WRITE_TOKEN=

# REQUIRED in production.
# Bearer secret Vercel Cron sends to /api/cron/maintenance.
CRON_SECRET=

# Test-mode payments (no real money). Required while the fake gateway is used.
FAKE_GATEWAY_SECRET=
# Allow the fake gateway in a production deployment (pre-launch test payments only). Never with real money.
ALLOW_FAKE_GATEWAY=

# Run migrations on server start when DATABASE_URL is set (otherwise run `npm run db:migrate`).
AUTO_MIGRATE=

# Development only: folder of the local PGlite database (default .data/pglite; in memory under tests).
PGLITE_DATA_DIR=
# Login-code TEST MODE (no SMS provider yet): 1 = show the login code on screen. Leave empty.
TEST_MODE_SHOW_LOGIN_CODE=
# Also allow that test mode in a production build. NEVER on a public deployment: anyone could log in as anyone.
ALLOW_TEST_LOGIN_CODES=
# Development only, owner's computer: local secret (>= 32 chars) letting `npm run admin:code` read the ADMIN login code; create it with `npm run admin:code -- --init`, never in Vercel.
TEST_MODE_ADMIN_KEY=
